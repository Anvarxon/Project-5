<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.8.0">
  <diagram name="C4 Context - Smart Home" id="smart-home-context">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1100">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="owner" value="Собственник / жилец&lt;br&gt;[Person]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Управляет доступом в дом и въездом&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="210" height="120" as="geometry"/></mxCell>
        <mxCell id="manager" value="Менеджер УК&lt;br&gt;[Person]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Назначает права и разбирает обращения&lt;/font&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="pd" value="PropDevelopment: сервисы собственников&lt;br&gt;[Software System]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Мобильный доступ к ЖКУ и «Умному дому»; хранит разрешения, аудит и связь с объектом, без биометрических шаблонов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="350" width="390" height="170" as="geometry"/></mxCell>
        <mxCell id="iam" value="Identity Provider&lt;br&gt;[Software System]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Аутентификация собственника и MFA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="380" y="690" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="partner" value="Платформа партнёра «Умный дом»&lt;br&gt;[External Software System]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Домофон, шлагбаум, распознавание лица и номера; хранит биометрический шаблон&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="350" height="160" as="geometry"/></mxCell>
        <mxCell id="devices" value="Устройства дома&lt;br&gt;[External System]&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Домофон и шлагбаум&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="security" value="Специалист ИБ / аудит&lt;br&gt;[Person]" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#052e56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" value="Запрос доступа, управление разрешениями; OIDC / TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="owner" target="pd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Управление домами и допусками" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="manager" target="pd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="OAuth 2.0 client credentials + mTLS; разрешения и команды, события доступа" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="pd" target="partner"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Управление / события устройств" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="partner" target="devices"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="OIDC authentication и MFA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="pd" target="iam"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Журналы обращений и инциденты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="pd" target="security"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
