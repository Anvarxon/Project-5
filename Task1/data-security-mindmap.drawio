<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.8.0">
  <diagram name="Безопасность данных" id="data-security-mindmap">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" page="1" pageWidth="2400" pageHeight="1700">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="center" value="Безопасность данных&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Классификация по ISO/IEC 27001, 27002&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#163a5a;fontColor=#ffffff;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="730" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="public" value="Публичные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="640" y="250" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="internal" value="Внутренние данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1460" y="250" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="confidential" value="Конфиденциальные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="1120" width="250" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="secret" value="Секретные данные" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1120" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="Маркетинговые материалы, публичные сведения о ЖК и квартирах&lt;br&gt;&lt;b&gt;Искажение: значительный&lt;/b&gt;&lt;br&gt;Обесценивание: незначительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e8;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="180" y="90" width="350" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p1r" value="Ошибочные цены и характеристики вводят покупателей в заблуждение и создают юридические и репутационные претензии; устаревшая реклама заменима." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="215" width="390" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="Общедоступные новости, уведомления УК и контакты офисов&lt;br&gt;&lt;b&gt;Потеря: незначительный&lt;/b&gt;&lt;br&gt;Искажение: значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf4e8;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="170" y="350" width="360" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p2r" value="Публикации можно восстановить, но подмена аварийных или платёжных уведомлений причинит вред собственникам." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="475" width="390" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="i1" value="Проектная документация, планы ремонтов и эксплуатационные регламенты&lt;br&gt;&lt;b&gt;Утечка: значительный&lt;/b&gt;&lt;br&gt;Искажение: значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1770" y="90" width="395" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="i1r" value="Раскрытие схем объектов облегчает злоупотребления, а неверные планы работ нарушают эксплуатацию домов." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1950" y="215" width="400" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="i2" value="Логи приложений, API-контракты, данные мониторинга и BI-агрегаты без ПДн&lt;br&gt;&lt;b&gt;Утечка: значительный&lt;/b&gt;&lt;br&gt;Некачественные: значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fd;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1770" y="350" width="395" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="i2r" value="Логи и контракты раскрывают поверхность атак; неполная телеметрия не позволит обнаружить инцидент или обучить корректную модель." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1950" y="480" width="400" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="Ф. И. О., телефон, e-mail, профиль клиента и собственника в CRM&lt;br&gt;&lt;b&gt;Утечка: критический&lt;/b&gt;&lt;br&gt;Искажение: критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e5;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="920" width="390" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="c1r" value="Это ПДн: уже наблюдается отображение чужого Ф. И. О.; нарушение идентификации ведёт к утечке, жалобам и требованиям законодательства РФ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="1050" width="430" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="Бронирования, результаты осмотров, анкета и документы онлайн-сделки&lt;br&gt;&lt;b&gt;Утечка: критический&lt;/b&gt;&lt;br&gt;Потеря: критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e5;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="70" y="1210" width="400" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="c2r" value="Набор раскрывает имущественные намерения и юридические сведения; потеря или подмена срывает сделку и регистрацию права." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="10" y="1340" width="435" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="Платежи ЖКУ, начисления и история ремонтов собственника&lt;br&gt;&lt;b&gt;Утечка: критический&lt;/b&gt;&lt;br&gt;Некачественные: значительный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e5;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="1430" width="390" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="c3r" value="Финансовые и адресные сведения связаны с человеком; ошибки начислений напрямую ухудшают сервис и требуют перерасчётов." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="465" y="1560" width="400" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="Пароли, ключи API партнёров, токены, сертификаты и резервные ключи&lt;br&gt;&lt;b&gt;Утечка: критический&lt;/b&gt;&lt;br&gt;Потеря: критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebea;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1830" y="920" width="405" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="s1r" value="Компрометация секрета даёт доступ к системам и данным, а утрата ключей делает зашифрованные данные или интеграции недоступными." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1920" y="1050" width="425" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="Биометрические шаблоны лица и списки допущенных автомобильных номеров&lt;br&gt;&lt;b&gt;Утечка: критический&lt;/b&gt;&lt;br&gt;Искажение: критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebea;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1830" y="1210" width="405" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="s2r" value="Биометрия не может быть сменена как пароль; подмена списка доступа позволяет физическое проникновение. Данные должны оставаться у специализированного партнёра." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1910" y="1340" width="435" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="Документы регистрации сделки и обмена с госорганами&lt;br&gt;&lt;b&gt;Утечка: критический&lt;/b&gt;&lt;br&gt;Искажение: критический" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebea;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1430" y="1430" width="390" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="s3r" value="Юридически значимые сведения определяют право собственности; изменение или раскрытие приводит к тяжёлым правовым последствиям." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1560" width="410" height="75" as="geometry"/>
        </mxCell>
